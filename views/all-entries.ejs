<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Entries</title>
</head>
<body>
  <h1>All Entries</h1>  
  <h2>This Page displays all the Entries that are public:</h2>

  <% for(let oneEntry of entry) { %> 
    <p>title: <%= oneEntry.title%></p>
    <p>The Entry Body: <%= oneEntry.entryBody %></p>
    <% if(user._id.toString()===oneEntry.owner._id.toString()) { %>
        <form action="/entries/<%= oneEntry._id %>/edit" method="get">
            <button>Edit</button>
        </form>
        <form action="/entries/<%= oneEntry._id%>/delete?_method=DELETE"  method="post">
            <button>Delete</button>
        </form>
  <% }%>
  <% }%>

  
</body>
</html>